{
    "name": "joomla/tracker",
    "description": "Issue tracking application extending GitHub's issues and pull requests for the Joomla! project.",
    "keywords": ["joomla", "tracker"],
    "homepage": "https://github.com/joomla/jissues",
    "license": "GPL-2.0+",
    "version": "1.0.0-beta",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "joomla/application": "^4.0",
        "joomla/authentication": "^4.0",
        "joomla/console": "^4.0",
        "joomla/controller": "^4.0",
        "joomla/database": "^4.0",
        "joomla/di": "^4.0",
        "joomla/event": "^4.0",
        "joomla/filter": "^4.0",
        "joomla/github": "^4.0",
        "joomla/http": "^4.0",
        "joomla/input": "^4.0",
        "joomla/model": "^4.0",
        "joomla/profiler": "^4.0",
        "joomla/registry": "^4.0",
        "joomla/router": "^4.0",
        "joomla/string": "^4.0",
        "joomla/uri": "^4.0",
        "joomla/utilities": "^4.0",
        "symfony/asset": "^7.4",
        "symfony/cache": "^7.4",
        "symfony/http-foundation": "^7.4",
        "twig/twig": "^3.8.0",
        "codeguy/upload": "1.3.2",
        "filp/whoops": "^2.15.4",
        "league/flysystem": "^3.22.0",
        "monolog/monolog": "^3.5",
        "kint-php/kint": "^6.1",
        "adaptive/php-text-difference": "^1.1.0",
        "laminas/laminas-diactoros": "^3.10"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.51.0",
        "phpunit/phpunit": "^9.6.11",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "replace": {
        "paragonie/random_compat": "*",
        "symfony/polyfill-php55": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php72": "*"
    },
    "autoload": {
        "psr-4": {
            "JTracker\\": "src/JTracker/",
            "App\\": "src/App/"
        }
    },
    "bin": ["bin/jtracker"],
    "autoload-dev": {
        "psr-4": {
            "JTracker\\Tests\\": "tests/tracker/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
