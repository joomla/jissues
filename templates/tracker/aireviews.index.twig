{% extends "index.twig" %}

{% block title %}{{ parent() }} | AI Reviews{% endblock %}

{% block content %}

    {% set kindLabels = {
        'testing_instructions': 'Testing instructions',
        'test_suitability': 'Test suitability',
        'duplicate': 'Possible duplicate',
        'fixed_elsewhere': 'Possibly fixed elsewhere',
        'obsolete': 'Possibly obsolete',
        'abandoned': 'Possibly abandoned',
        'needs_info': 'Needs information'
    } %}

    <div class="page-header">
        <h1>AI Reviews <small class="text-muted">{{ project.title }}</small></h1>
    </div>

    <div class="alert alert-warning">
        These findings were generated by an AI review and may be wrong. Check every finding before you act on it.
        Nothing is changed on GitHub until you click an action, and every change is made with your own GitHub account.
    </div>

    <form method="get" action="{{ uri.base.path }}tracker/{{ project.alias }}/ai-reviews" class="row g-2 mb-3 align-items-end">
        <div class="col-auto">
            <label for="filter-state" class="form-label">State</label>
            <select id="filter-state" name="state" class="form-select">
                {% for state in states %}
                    <option value="{{ state }}"{{ filters.state == state ? ' selected' }}>{{ state|capitalize }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-auto">
            <label for="filter-kind" class="form-label">Finding</label>
            <select id="filter-kind" name="kind" class="form-select">
                <option value="">All</option>
                {% for kind in kinds %}
                    <option value="{{ kind }}"{{ filters.kind == kind ? ' selected' }}>{{ kindLabels[kind] ?? kind }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-auto">
            <label for="filter-rating" class="form-label">Rating</label>
            <select id="filter-rating" name="rating" class="form-select">
                <option value="">All</option>
                {% for rating in ['missing', 'inadequate', 'yes', 'partly', 'no'] %}
                    <option value="{{ rating }}"{{ filters.rating == rating ? ' selected' }}>{{ rating }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-auto">
            <label for="filter-confidence" class="form-label">Confidence</label>
            <select id="filter-confidence" name="confidence" class="form-select">
                <option value="">All</option>
                {% for confidence in ['high', 'medium', 'low'] %}
                    <option value="{{ confidence }}"{{ filters.confidence == confidence ? ' selected' }}>{{ confidence }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-auto">
            <label for="filter-type" class="form-label">Type</label>
            <select id="filter-type" name="type" class="form-select">
                <option value="">Issues and PRs</option>
                <option value="issue"{{ filters.type == 'issue' ? ' selected' }}>Issues</option>
                <option value="pr"{{ filters.type == 'pr' ? ' selected' }}>Pull requests</option>
            </select>
        </div>
        <div class="col-auto">
            <label for="filter-search" class="form-label">Search</label>
            <input id="filter-search" type="search" name="search" class="form-control" value="{{ filters.search }}" placeholder="#number or text" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </form>

    <p class="text-muted">{{ total }} finding{{ total == 1 ? '' : 's' }}.
        {% if filters.state == 'open' %}
            Reviews of items that changed since the review (new commit, edited description, new comment or test) are hidden until the next review run.
        {% endif %}
    </p>

    {% for finding in items %}
        {% include "aireview.finding.twig" with {'finding': finding, 'project': project, 'showItem': true} only %}
    {% else %}
        <p>No findings match the filters.</p>
    {% endfor %}

    {% if pagination.pagesTotal > 1 %}
        {{ "Page %1$s of %2$s"|format(pagination.pageNo, pagination.pagesTotal) }}
        {{ pagination.bar|raw }}
    {% endif %}

{% endblock %}

{% block JavaScriptBottom %}
    {{ parent() }}
    {% include "aireview.script.twig" %}
{% endblock %}
